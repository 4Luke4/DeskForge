+int deskforge_vtest_run(int listener_fd, unsigned expected_peer_uid,
+                        unsigned maximum_clients, unsigned maximum_command_bytes,
+                        unsigned enable_venus)
+{
+   if (listener_fd < 0 || !expected_peer_uid || !maximum_clients || !maximum_command_bytes)
+      return -EINVAL;
+
+   server.socket = listener_fd;
+   server.expected_peer_uid = expected_peer_uid;
+   server.maximum_clients = maximum_clients;
+   server.client_count = 0;
+   server.do_fork = false;
+   server.loop = true;
+   server.multi_clients = true;
+   server.ctx_flags = VIRGL_RENDERER_USE_EGL |
+                      VIRGL_RENDERER_USE_SURFACELESS |
+                      VIRGL_RENDERER_USE_GLES;
+   if (enable_venus)
+      server.ctx_flags |= VIRGL_RENDERER_VENUS | VIRGL_RENDERER_RENDER_SERVER;
+   list_inithead(&server.new_clients);
+   list_inithead(&server.active_clients);
+   list_inithead(&server.inactive_clients);
+   vtest_set_max_length(maximum_command_bytes);
+   vtest_server_run();
+   return 0;
+}
